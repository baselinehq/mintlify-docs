            },
            {
              "name": "OperatingSystem",
              "in": "query",
              "description": "Operating system (optional)",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/types.VMInfo"
