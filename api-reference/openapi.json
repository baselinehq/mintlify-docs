          "summary": "VM Metadata",
          "description": "Get metadata for VMs\nThis endpoint retrieves metadata for VMs based on the provided time range.\nIt fetches data from the VMInfo table and returns it as a JSON array.\nThe time range is specified by the start_date and end_date query parameters in RFC\n3339 format (e.g., 2023-10-01T00:00:00Z).",
          "parameters": [
            {
              "name": "Name",
              "in": "query",
              "description": "Name of the VM (optional)",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "Hostname",
