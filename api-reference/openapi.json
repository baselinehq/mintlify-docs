            },
            "401": {
              "description": "Unauthorized",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/types.ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/types.ErrorResponse"
                  }
                }
              }
            }
          },
          "security": [
            {
              "ApiKeyAuth": []
            },
            {
              "BearerAuth": []
            }
          ]
        }
      },
      "/v1/namespace_recommendations": {
        "get": {
          "tags": [
            "Kubernetes"
          ],
          "summary": "Namespace Recommendations",
          "description": "Get recommendations for Kubernetes namespaces\nThis endpoint retrieves recommendations for Kubernetes namespaces based on the provided time range.\nIt fetches data from the K8sNamespaceRecommendations table and returns it as a JSON array.\nThe time range is specified by the start_date and end_date query parameters in RFC\n3339 format (e.g., 2023-10-01T00:00:00Z).\nThe recommendations include details such as CPU usage, memory usage, and resource allocation\nfor each namespace.",
          "parameters": [
            {
              "name": "cluster",
              "in": "query",
              "description": "Cluster name",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "namespace",
              "in": "query",
              "description": "Namespace",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "start_date",
              "in": "query",
              "description": "Start date in RFC3339 format (e.g., 2023-10-01T00:00:00Z)",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "end_date",
              "in": "query",
              "description": "End date in RFC3339 format (e.g :, 2023-10-31T23:59:59Z)",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/types.NamespaceRecommendation"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Bad Request",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/types.ErrorResponse"
                  }
                }
              }
            },
            "401": {
              "description": "Unauthorized",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/types.ErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/types.ErrorResponse"
                  }
                }
              }
            }
          },
          "security": [
            {
              "ApiKeyAuth": []
            },
            {
              "BearerAuth": []
            }
          ]
        }
      },
