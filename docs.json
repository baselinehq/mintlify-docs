{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "CostGraph Documentation",
  "colors": {
    "primary": "#0F6DFF",
    "light": "#5394FD",
    "dark": "#0E46A0"
  },
  "fonts": {
    "heading": {
      "family": "Funnel Display"
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#090A0B"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "CostGraph",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "concepts/how-it-works"
            ]
          },
          {
            "group": "Costgraph Operator",
            "pages": [
              "costgraph/overview",
              "costgraph/installation/operator/kubernetes-operator",
              "costgraph/configuration/kubernetes",
              "changelog/costgraph/operator"
            ]
          },
          {
            "group": "Costgraph Agent",
            "pages": [
              "costgraph/agent",
              "costgraph/recommendations",
              "changelog/costgraph/agent"
            ]
          },
          {
            "group": "MCP",
            "icon": "plug",
            "pages": [
              "costgraph/mcp/install",
              "costgraph/mcp/usage"
            ]
          }
        ]
      },
      {
        "tab": "Pricing API",
        "openapi": "https://raw.githubusercontent.com/baselinehq/mintlify-docs/main/api-reference/openapi.json",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "pricing-api/SDKs/install",
              "pricing-api/SDKs/go",
              "pricing-api/SDKs/typescript"
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              "POST /pricing/compute",
              "POST /pricing/disks",
              "POST /recommendations",
              "POST /recommendations/compute",
              "POST /recommendations/disks",
              "GET /providers"
            ]
          },
          {
            "group": "Marketplace",
            "pages": [
              "GET /marketplace/providers/compute",
              "POST /marketplace/providers/compute",
              "DELETE /marketplace/providers/compute",
              "GET /marketplace/providers/disks",
              "POST /marketplace/providers/disks",
              "DELETE /marketplace/providers/disks"
            ]
          },
          {
            "group": "Changelog",
            "icon": "clock-rotate-left",
            "pages": [
              "changelog/pricing/api"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.costgraph.ai",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Community",
          "href": "https://x.com/costgraph_dev",
          "icon": "x"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.costgraph.ai",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Talk to support",
        "href": "mailto:contact@baselinehq.cloud"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Platform",
      "href": "https://app.costgraph.ai"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/costgraph_dev",
      "github": "https://github.com/baselinehq",
      "linkedin": "https://linkedin.com/company/baselinehq"
    }
  },
  "redirects": [
    {
      "source": "/costgraph/installation/agent/agent-systemd",
      "destination": "/costgraph/agent#install"
    },
    {
      "source": "/costgraph/installation/agent/agent-docker",
      "destination": "/costgraph/agent#install"
    },
    {
      "source": "/costgraph/installation/agent/virtual-machines",
      "destination": "/costgraph/agent#install"
    },
    {
      "source": "/costgraph/installation/agent/agent-homebrew",
      "destination": "/costgraph/agent#install"
    },
    {
      "source": "/costgraph/configuration/agent",
      "destination": "/costgraph/agent#configuration"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  }
}
