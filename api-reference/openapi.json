      "/v1/compute/recommendations": {
        "get": {
          "tags": [
            "Compute"
          ],
          "summary": "Compute Recommendations",
          "description": "Get all node recommendations for K8s backed nodes\nThis endpoint computes recommendations for K8s instances based on the data available in the database.\nIt retrieves the recommendations from the K8sInstanceRecommendations table and returns them as a JSON array.\nThe recommendations include details such as instance type, resource usage, and suggested changes.",
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/types.K8sInstanceRecommendation"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Bad Request",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/types.ErrorResponse"
                  }
                }
